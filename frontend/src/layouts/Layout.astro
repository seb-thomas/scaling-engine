---
import Header from '../components/Header.astro';
// Fonts are bundled (Fontsource) rather than loaded from Google Fonts, which
// cost a render-blocking stylesheet request to a third-party origin
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import garamondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'book';
  pathname?: string;
}

const SITE_URL = 'https://radioreads.fun';
const DEFAULT_DESCRIPTION = 'Discover books discussed, reviewed and recommended on BBC Radio 4 and NPR. Author interviews, reviews and prize-winners from Front Row, Bookclub, Free Thinking, A Good Read and Fresh Air.';

const {
  title = 'Radio Reads — Books from Radio Shows',
  description = DEFAULT_DESCRIPTION,
  ogImage,
  ogType = 'website',
  pathname = Astro.url.pathname,
} = Astro.props;

const canonicalURL = new URL(pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={garamondLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Radio Reads" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Chrome/Edge prerender a page when its link is hovered (or pressed), so
         the click shows it instantly. Other browsers ignore this. -->
    <script is:inline type="speculationrules">
      {
        "prerender": [{
          "where": { "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": ["/admin/*", "/api/*", "/media/*", "/staticfiles/*"] } }
          ] },
          "eagerness": "moderate"
        }]
      }
    </script>
    <script is:inline>
      // Follow the system colour scheme; runs before first paint to prevent a flash
      (function() {
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = () => document.documentElement.classList.toggle('dark', mq.matches);
        apply();
        mq.addEventListener('change', apply);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
    <Header pathname={pathname} />
    <main class="pb-16">
      <slot />
    </main>
  </body>
</html>

