---
import Header from '../components/Header.astro';
// Fonts are bundled (Fontsource) rather than loaded from Google Fonts, which
// cost a render-blocking stylesheet request to a third-party origin
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import garamondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import garamondLatinItalic from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-italic.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../index.css';
import { createHash } from 'node:crypto';
import { headScript } from '../lib/headScript';
import { SITE_URL, serializeJsonLd } from '../lib/structuredData';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'book';
  pathname?: string;
  /** schema.org structured data for this page */
  jsonLd?: object;
  /** Keep this page out of search results (error pages) */
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION = 'Books discussed on BBC Radio 4 and NPR — author interviews, reviews and prize-winners, each with a link to the episode so you can hear the conversation.';

const {
  title = 'Radio Reads — Books discussed on BBC Radio 4 and NPR',
  description = DEFAULT_DESCRIPTION,
  ogImage,
  ogType = 'website',
  pathname = Astro.url.pathname,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(pathname, SITE_URL).href;
// Covers come from the API as /media/... paths; social cards need absolute URLs
const ogImageURL = ogImage ? new URL(ogImage, SITE_URL).href : undefined;

const speculationRules = JSON.stringify({
  prerender: [{
    where: { and: [
      { href_matches: '/*' },
      { not: { href_matches: ['/admin/*', '/api/*', '/media/*', '/staticfiles/*'] } },
    ] },
    eagerness: 'moderate',
  }],
});

// Astro's CSP hashes the scripts it bundles but not is:inline ones, so
// allow these two by the hash of their exact contents
for (const code of [speculationRules, headScript]) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(code).digest('base64')}`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={garamondLatin} as="font" type="font/woff2" crossorigin />
    <!-- The italic is used by the header logo on every page -->
    <link rel="preload" href={garamondLatinItalic} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Radio Reads" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Chrome/Edge prerender a page when its link is hovered (or pressed), so
         the click shows it instantly. Other browsers ignore this. -->
    <script is:inline type="speculationrules" set:html={speculationRules} />
    <script is:inline set:html={headScript} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
    <Header pathname={pathname} />
    <main class="pb-16">
      <slot />
    </main>
  </body>
</html>

