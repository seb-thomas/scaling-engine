---
import Breadcrumbs from './Breadcrumbs.astro'
import BookList from './BookList.astro'
import type { Book, Show } from '../types'

interface Props {
  show: Show
  books: { results: Book[]; count: number }
  currentPage: number
  booksPerPage: number
}

const { show, books, currentPage, booksPerPage } = Astro.props

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: show.station.name, href: `/station/${show.station.station_id}` },
  { label: show.name },
]
---
<div class="container py-12">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="mb-12">
    <div class="text-xs tracking-wider uppercase text-gray-600 dark:text-gray-400 mb-3">{show.station.name}</div>
    <h1 class="font-serif text-3xl font-medium mb-4">{show.name}</h1>
    {show.description && <p class="text-gray-700 dark:text-gray-400 mb-2">{show.description}</p>}
    {show.producer_name && (
      <p class="text-sm text-gray-500 dark:text-gray-500 mb-2">
        From{' '}
        {show.producer_url ? (
          <a href={show.producer_url} target="_blank" rel="noopener" class="underline hover:text-orange-700 dark:hover:text-orange-400 transition-colors">{show.producer_name}</a>
        ) : (
          show.producer_name
        )}
      </p>
    )}
    <p class="text-sm text-gray-500 dark:text-gray-400">
      {show.book_count.toLocaleString('en-GB')} book{show.book_count !== 1 ? 's' : ''}
    </p>
  </div>

  <div>
    <div class="border-b border-gray-200 dark:border-gray-800 mb-8">
      <h2 class="text-sm tracking-wider uppercase mb-4">Books</h2>
    </div>

    <div class="max-w-4xl">
      <BookList books={books} currentPage={currentPage} booksPerPage={booksPerPage} url={Astro.url} />
    </div>
  </div>
</div>
