---
import Breadcrumbs from './Breadcrumbs.astro'
import TopicCard from './TopicCard.astro'
import type { Topic } from '../types'

interface Props {
  topics: Topic[]
  stationNames: string[]
}

const { topics, stationNames } = Astro.props

// Extract short network names: "BBC Radio 4" → "BBC", "NPR Fresh Air" → "NPR"
const networks = [...new Set(stationNames.map((n) => n.split(/\s/)[0]))]
const stationsText = networks.length > 0 ? networks.join(' and ') : 'radio'
---
<div class="container py-12">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Topics' }]} />

  <div class="mb-12">
    <h1 class="font-serif text-3xl font-medium mb-4">Browse by Topic</h1>
    <p class="text-gray-700 dark:text-gray-400">
      Explore books discussed on radio by genre and theme. Each topic collects
      books featured across {stationsText} programmes.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {topics.map((topic) => <TopicCard topic={topic} />)}
  </div>
</div>
