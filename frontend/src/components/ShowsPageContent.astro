---
import Breadcrumbs from './Breadcrumbs.astro'
import ShowCard from './ShowCard.astro'
import type { Show, Station } from '../types'

interface Props {
  shows: Show[]
  stations: Station[]
}

const { shows, stations } = Astro.props

// Group shows by station
const showsByStation = stations
  .map((station) => ({ station, shows: shows.filter((show) => show.station?.station_id === station.station_id) }))
  .filter((group) => group.shows.length > 0)
---
<div class="container py-12">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shows' }]} />

  <div class="mb-12">
    <h1 class="font-serif text-3xl font-medium mb-4">Shows</h1>
    <p class="text-gray-700 dark:text-gray-400">Explore all radio shows from {stations.map((s) => s.name).join(' and ')}</p>
  </div>

  {showsByStation.map(({ station, shows: stationShows }, index) => (
    <section class={index < showsByStation.length - 1 ? 'mb-16' : ''}>
      <div class="border-b border-gray-200 dark:border-gray-800 mb-8">
        <a href={`/station/${station.station_id}`} class="hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
          <h2 class="text-sm tracking-wider uppercase mb-4">{station.name}</h2>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {stationShows.map((show) => <ShowCard show={show} />)}
      </div>
    </section>
  ))}
</div>
