---
import Breadcrumbs from './Breadcrumbs.astro'
import ShowCard from './ShowCard.astro'
import type { Show, Station } from '../types'

interface Props {
  station: Station
  shows: Show[]
}

const { station, shows } = Astro.props
const linkClass = 'text-sm text-gray-600 dark:text-gray-400 hover:text-orange-700 dark:hover:text-orange-400 transition-colors'
---
<div class="container py-8 md:py-12">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: station.name }]} />

  <div class="mb-12">
    <h1 class="font-serif text-4xl mb-4">{station.name}</h1>
    {station.description && <p class="text-gray-700 dark:text-gray-400 mb-4 max-w-2xl">{station.description}</p>}
    <div class="flex items-center gap-4">
      {station.station_id === 'npr' ? (
        <a href="https://www.npr.org/support" target="_blank" rel="noopener" class={linkClass}>Support NPR &rarr;</a>
      ) : station.url && (
        <a href={station.url} target="_blank" rel="noopener" class={linkClass}>Visit {station.name} &rarr;</a>
      )}
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">{shows.length} show{shows.length !== 1 ? 's' : ''}</p>
  </div>

  <div>
    <div class="border-b border-gray-200 dark:border-gray-800 mb-8">
      <h2 class="text-sm tracking-wider uppercase mb-4">Shows</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {shows.map((show) => <ShowCard show={show} />)}
    </div>
  </div>
</div>
