---
import BookCard from './BookCard.astro'
import ShowCard from './ShowCard.astro'
import type { Book, Show } from '../types'

interface Props {
  books: { results: Book[]; count: number }
  shows: Show[]
}

const { books, shows } = Astro.props

// "This week" is the last 7 days of broadcasts. On a quiet week, fall back
// to the most recent books so the page never looks empty.
const WEEK_MS = 7 * 24 * 60 * 60 * 1000
const airedAt = (book: Book) => {
  const at = book.episodes?.[0]?.aired_at
  return at ? new Date(at).getTime() : 0
}
const thisWeek = books.results.filter((book) => Date.now() - airedAt(book) < WEEK_MS)
const onAir = thisWeek.length >= 4 ? thisWeek : books.results.slice(0, 8)
const heading = thisWeek.length >= 4 ? 'This week on air' : 'Recently on air'
---
<div class="container py-12">
  <section class="max-w-2xl mb-16">
    <h1 class="font-serif text-3xl md:text-4xl leading-tight mb-5">
      Books worth talking about.
    </h1>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      Every day the presenters of your favourite radio shows sit down with
      writers and critics to talk about books. Here are the books, each with
      its programme, so you can hear what was said.
    </p>
  </section>

  <section class="mb-16">
    <div class="border-b border-gray-200 dark:border-gray-800 mb-8">
      <h2 class="text-sm tracking-wider uppercase mb-4">{heading}</h2>
    </div>

    <div class="max-w-4xl">
      {onAir.map((book, index) => (
        <BookCard book={book} featured={index === 0 && !!book.description} priority={index === 0} />
      ))}

      <div class="mt-8 text-left">
        <a href="/books" class="text-sm hover:opacity-70 transition-opacity">Every book, newest first →</a>
      </div>
    </div>
  </section>

  {shows.length > 0 && (
    <section>
      <div class="border-b border-gray-200 dark:border-gray-800 mb-8">
        <h2 class="text-sm tracking-wider uppercase mb-4">Where we listen</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {shows.slice(0, 6).map((show) => <ShowCard show={show} />)}
      </div>

      {shows.length > 6 && (
        <div class="mt-8">
          <a href="/shows" class="text-sm hover:opacity-70 transition-opacity">All {shows.length} shows →</a>
        </div>
      )}
    </section>
  )}
</div>
