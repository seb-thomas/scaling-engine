---
import Layout from '../layouts/Layout.astro';
import { fetchShows } from '../api/client';
import type { Show } from '../types';

let shows: Show[] = [];

try {
  const showsData = await fetchShows().catch(() => []);
  shows = Array.isArray(showsData) ? showsData : (showsData as any).results || [];
} catch {}

// Group shows by station: { "BBC Radio 4": ["Front Row", "Free Thinking", ...], "NPR": ["Fresh Air"] }
const stationMap = new Map<string, string[]>();
for (const show of shows) {
  const stationName = show.station?.name || 'Radio';
  if (!stationMap.has(stationName)) stationMap.set(stationName, []);
  stationMap.get(stationName)!.push(show.name);
}

// Build prose: "Front Row, Free Thinking, Bookclub and A Good Read on BBC Radio 4, and Fresh Air on NPR"
function listWithAnd(items: string[]) {
  if (items.length <= 1) return items[0] || '';
  return items.slice(0, -1).join(', ') + ' and ' + items[items.length - 1];
}

const stationPhrases = [...stationMap.entries()].map(
  ([station, names]) => `${listWithAnd(names)} on ${station}`
);
const showsSentence = stationPhrases.length > 0
  ? `We listen to ${shows.length} show${shows.length !== 1 ? 's' : ''} across ${stationMap.size} network${stationMap.size !== 1 ? 's' : ''}: ${listWithAnd(stationPhrases)}.`
  : '';
---

<Layout
  title="About — Radio Reads"
  description="Radio Reads keeps a list of the books talked about on BBC Radio 4 and NPR, each with a link to the conversation, so you can hear what was said before you read it."
  pathname="/about"
>
  <div class="container pt-10 pb-16 max-w-2xl">
    <h1 class="font-serif text-3xl mb-8">About Radio Reads</h1>

    <div class="space-y-5 text-gray-600 dark:text-gray-400 leading-relaxed">
      <p>
        Radio is one of the best places to hear about books. A novelist gets
        twenty minutes to explain what they were trying to do. A critic says
        why a book stayed with them. A panel argues about whether the prize
        went to the right one. Then the programme ends, and all of it
        disappears into the archive.
      </p>

      <p>
        Radio Reads keeps the list. Every book here was the subject of a
        conversation: an author interview, a review, a debate or a prize.
        Passing mentions don't count. Each book links back to the episode,
        so you can hear what was said before you decide whether to read it.
        It's a better way to choose a book than a star rating.
      </p>

      <p>
        It's also useful if you caught half an interview in the car and
        missed the title, or you're looking for a present and trust the
        taste of a favourite show.
      </p>

      {showsSentence && (
        <p>
          {showsSentence} New books usually appear within a day of broadcast.
        </p>
      )}

      <p>
        Software does the listening. It reads each episode's notes, picks out
        the books being discussed, and checks them against Google Books. It
        gets things wrong sometimes. If you spot a mistake, or a book that
        should be here and isn't, please say so on <a
          href="https://github.com/seb-thomas/scaling-engine/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
        >GitHub</a>, where the code is also open source.
      </p>
    </div>
  </div>
</Layout>
