---
import Layout from '../layouts/Layout.astro';
import HomePageContent from '../components/HomePageContent.astro';
import { fetchBooks, fetchShows } from '../api/client';
import type { Show } from '../types';

// Fetch data (equivalent to loader function)
let books = { results: [], count: 0 };
let shows: Show[] = [];

try {
  const [booksData, showsData] = await Promise.all([
    fetchBooks(1, 16).catch(() => ({ results: [], count: 0 })),
    fetchShows().catch(() => [])
  ]);
  
  books = booksData;
  shows = Array.isArray(showsData) 
    ? showsData 
    : showsData.results || [];
} catch (error) {
  console.error('Error fetching data:', error);
  // Use empty data as fallback
}
---

<Layout
  title="Radio Reads — Books discussed on BBC Radio 4 and NPR"
  description="The books talked about on BBC Radio 4 and NPR this week, from Front Row, Start the Week, Fresh Air and more. Each one comes with the conversation, so you can hear what they said before you read it."
  pathname={Astro.url.pathname}
>
  <HomePageContent books={books} shows={shows} />
</Layout>

