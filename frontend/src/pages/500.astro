---
import Layout from '../layouts/Layout.astro';
import { reportServerError } from '../lib/errorTracking';

interface Props {
  error: unknown;
}

await reportServerError(Astro.props.error, Astro.url);
---

<Layout title="Something went wrong — Radio Reads" pathname="/500" noindex>
  <div class="container pt-10 pb-16 max-w-2xl">
    <h1 class="font-serif text-3xl mb-6">Something went wrong</h1>
    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
      This page didn't load properly. Please try again in a minute.
    </p>
  </div>
</Layout>
