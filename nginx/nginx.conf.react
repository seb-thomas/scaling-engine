# Compression for HTML, JS, CSS, JSON and SVG (including proxied responses)
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml;

# Short-lived cache of rendered pages. Content only changes when new books
# are extracted, so a page up to a minute old is fine, and repeat visits skip
# the Astro -> Django round trip. The deploy clears it (new builds rename the
# /_astro/ assets old HTML points at). Send "X-Cache-Bypass: 1" to go straight
# to the app: the watchdog, deploy smoke test and uptime check do, so a cached
# copy can't hide a broken frontend.
proxy_cache_path /var/cache/nginx/pages levels=1:2 keys_zone=pages:10m max_size=256m inactive=10m use_temp_path=off;

upstream paperwaves {
    server web:8000;
}

upstream frontend {
    server frontend:3000;
}

# HTTP server - ACME challenge for Let's Encrypt, then redirect to HTTPS
server {
    listen 80;
    server_name radioreads.fun;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# Reject requests to IP address (HTTP)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;  # Close connection without response
}

# Reject requests to IP address (HTTPS)
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/radioreads.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/radioreads.fun/privkey.pem;

    return 444;  # Close connection without response
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name radioreads.fun;

    ssl_certificate /etc/letsencrypt/live/radioreads.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/radioreads.fun/privkey.pem;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Admin requests go to Django
    location /admin/ {
        proxy_pass http://paperwaves;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header Host $host;
        proxy_redirect off;
    }

    # API requests go to Django
    location /api/ {
        proxy_pass http://paperwaves;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header Host $host;
        proxy_redirect off;
    }

    # Static files from Django
    location /staticfiles/ {
        alias /home/app/web/staticfiles/;
    }

    # Cover thumbnails: URLs carry ?v=<mtime>, so they can be cached for a year
    location /media/thumbs/ {
        alias /home/app/web/media/thumbs/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Media files (book covers, etc.)
    location /media/ {
        alias /home/app/web/media/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Astro build assets: content-hashed filenames, so cache them forever
    location /_astro/ {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # All other requests go to React SSR
    location / {
        proxy_pass http://frontend;
        proxy_cache pages;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_valid 200 60s;
        proxy_cache_valid 404 10s;
        # Serve the stale copy while one request refreshes it in the background
        proxy_cache_use_stale updating;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_cache_bypass $http_x_cache_bypass;
        add_header X-Cache $upstream_cache_status always;
        # Security headers for the Astro pages (Django sets its own on /admin/
        # and /api/). Astro sends the script/style CSP; frame-ancestors can only
        # come from a header, so it's here. Browsers enforce both policies.
        # No includeSubDomains, matching Django's HSTS setting.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options DENY always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header Host $host;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

